{
  "name": "ssg",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ssg/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/ssg"],
      "options": {
        "command": "vite build",
        "cwd": "apps/ssg"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/ssg/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/ssg"],
      "options": {
        "command": "vitest run --passWithNoTests",
        "cwd": "apps/ssg"
      }
    }
  },
  "tags": ["scope:frontend", "type:app"]
}
