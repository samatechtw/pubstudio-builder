  {
    "name": "stable component insertion and edit",
    "initial": {
      "name": "Site",
      "version": "3",
      "context": {},
      "defaults": {
        "homePage": "/"
      },
      "pages": {
        "/": {
          "root": {
            "id": "root",
            "children": [
              {
                "id": "a",
                "content": "A"
              },
              {
                "id": "b",
                "content": "B"
              }
            ]
          }
        }
      },
      "page_order": ["/"]
    },
    "batch": {
      "protocol_version": 1,
      "batch_id": "fixture-insert",
      "client_id": "fixture-client",
      "base_revision": 0,
      "commands": [
        {
          "type": "insert",
          "section": "pages",
          "path": ["/", "root", "children"],
          "item_id": "c",
          "item": {
            "id": "c",
            "content": "C"
          },
          "after_id": "a",
          "before_id": "b"
        },
        {
          "type": "set",
          "section": "pages",
          "path": [
            "/",
            "root",
            "children",
            {
              "id": "b"
            },
            "content"
          ],
          "expected": {
            "kind": "value",
            "value": "B"
          },
          "value": "Updated"
        }
      ]
    },
    "expected": {
      "name": "Site",
      "version": "3",
      "context": {},
      "defaults": {
        "homePage": "/"
      },
      "pages": {
        "/": {
          "root": {
            "id": "root",
            "children": [
              {
                "id": "a",
                "content": "A"
              },
              {
                "id": "c",
                "content": "C"
              },
              {
                "id": "b",
                "content": "Updated"
              }
            ]
          }
        }
      },
      "page_order": ["/"]
    }
  },
